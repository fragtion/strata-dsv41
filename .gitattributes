# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# the quant yardstick's text set: tokenized byte for byte (set.ids.json), never convert its line endings
terminal/data/quant_quality/** -text

# the license text is shipped and checked as LF text on every checkout
LICENSE text eol=lf

# Apple tools (codesign, plutil) read these: LF only, wherever the repository is cloned
*.plist text eol=lf

# vendored KaTeX (terminal/serve/web/vendor): the files are hashed byte for byte (PROVENANCE.json), never convert their line endings.
terminal/serve/web/vendor/** -text
engine/third_party/strata-ggml/** text eol=lf

# chat templates are read and hashed byte for byte (the served prompt): LF wherever the repository is cloned
*.jinja text eol=lf

# cmake/strata_ggml.cmake - the engine's ggml-base / ggml-cpu, built from the tree vendored in third_party/strata-ggml (no download).
# Macros: they run in the caller's scope.

# where the ggml tree is (repo_root: the checkout; metal/ passes <repo>/metal/..)
macro(strata_ggml_resolve repo_root)
  get_filename_component(_strata_ggml_root "${repo_root}/third_party/strata-ggml" ABSOLUTE)
endmacro()

# ggml-base / ggml-cpu as static libraries, with the CPU features of the build kind (portable, ISA floor, native)
macro(strata_ggml_configure_root)
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(GGML_STATIC ON CACHE BOOL "" FORCE)
  set(GGML_CUDA OFF CACHE BOOL "" FORCE)
  set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
  set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
  set(GGML_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(GGML_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  if(STRATA_PORTABLE AND NOT STRATA_CPU_X86)
    # arm64: ggml-cpu for any Armv8.2 CPU with dot product, FP16 and int8 matmul instead of the build host's
    set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
    set(STRATA_ARM64_ARCH "armv8.2-a+dotprod+fp16+i8mm" CACHE STRING "arm64: ggml-cpu's -march for a STRATA_PORTABLE build")
    set(GGML_CPU_ARM_ARCH "${STRATA_ARM64_ARCH}" CACHE STRING "" FORCE)
  elseif(STRATA_PORTABLE)
    set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
    foreach(_f GGML_AVX GGML_AVX2 GGML_FMA GGML_F16C)
      set(${_f} ON CACHE BOOL "" FORCE)
    endforeach()
    # BMI2 OFF: ggml's IQ1_S / IQ1_M dots use _pdep_u64 with it, and AMD Zen 1/2 run PDEP in microcode (upstream measured an
    # EPYC 7452 IQ1_M one-token dot at 1.8 GB/s with it against 32 GB/s without). The results are bit-identical either way.
    set(GGML_BMI2 OFF CACHE BOOL "" FORCE)
  elseif(STRATA_ISA_FLOOR)
    # the experimental older-CPU build: one ggml-cpu for the floor, SSE4.2 + AVX ("avx") or SSE4.2 alone ("none")
    set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
    set(GGML_CPU_ALL_VARIANTS OFF CACHE BOOL "" FORCE)
    set(GGML_SSE42 ON CACHE BOOL "" FORCE)
    if(STRATA_ISA_FLOOR STREQUAL "avx")
      set(GGML_AVX ON CACHE BOOL "" FORCE)
    else()
      set(GGML_AVX OFF CACHE BOOL "" FORCE)
    endif()
    foreach(_f GGML_AVX2 GGML_FMA GGML_F16C GGML_BMI2 GGML_AVX_VNNI GGML_AVX512 GGML_AVX512_VBMI GGML_AVX512_VNNI
               GGML_AVX512_BF16 GGML_AMX_TILE GGML_AMX_INT8 GGML_AMX_BF16)
      set(${_f} OFF CACHE BOOL "" FORCE)
    endforeach()
  else()
    set(GGML_NATIVE ON CACHE BOOL "" FORCE)
  endif()
  add_subdirectory(${_strata_ggml_root}/ggml ${CMAKE_BINARY_DIR}/ggml EXCLUDE_FROM_ALL)
endmacro()
